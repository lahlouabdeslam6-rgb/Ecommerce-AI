{
  "id": "nutrifit-abandoned-cart",
  "name": "NUTRIFIT - Abandoned carts",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "schedule-cart",
      "name": "Toutes les 6 heures",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "scan-cart",
      "name": "Detecter les paniers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automations/carts/abandoned?older_than_hours=24",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.AUTOMATION_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Toutes les 6 heures": {
      "main": [
        [
          {
            "node": "Detecter les paniers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
