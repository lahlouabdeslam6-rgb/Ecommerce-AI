MONGO_ROOT_USERNAME=ecommerce_admin
MONGO_ROOT_PASSWORD=change_this_password
MONGO_DATABASE=ecommerce_ai
MONGO_HOST_PORT=27018

MONGODB_URL=mongodb://ecommerce_admin:change_this_password@mongo:27017/ecommerce_ai?authSource=admin
SQLITE_URL=sqlite+aiosqlite:///./data/ecommerce.db

JWT_SECRET_KEY=generate_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
