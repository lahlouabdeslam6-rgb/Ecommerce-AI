MONGO_ROOT_USERNAME=ecommerce_admin
MONGO_ROOT_PASSWORD=change_this_password
MONGO_DATABASE=ecommerce_ai
MONGO_HOST_PORT=27018

MONGODB_URL=mongodb://ecommerce_admin:change_this_password@mongo:27017/ecommerce_ai?authSource=admin
SQLITE_URL=sqlite+aiosqlite:///./data/ecommerce.db

JWT_SECRET_KEY=generate_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379

QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
QDRANT_COLLECTION=nutrifit_products

OLLAMA_URL=http://ollama:11434
OLLAMA_HOST_PORT=11435
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
